using System;
using System.Windows.Forms;

namespace TuNombreDeProyecto 
{
    public partial class frmLogin : Form
    {
        public frmLogin()
        {
            InitializeComponent();
            
            // La contraseña no debe mostrarse en texto plano por defecto.
            // Alternamos la propiedad PasswordChar con el caracter '•' [3].
            txtContrasena.PasswordChar = '•';
        }

        // Validaciones completas sobre todos los campos antes de procesar cualquier operación [1].
        private bool ValidarCamposLogin()
        {
            // Validamos que el nombre de usuario y contraseña no estén vacíos antes de consultar los datos [3].
            if (txtUsuario.Text == "" || txtContrasena.Text == "")
            {
                lblError.Text = "El nombre de usuario y la contraseña no pueden estar vacíos.";
                lblError.Visible = true;
                return false;
            }
            return true;
        }

        private void btnIngresar_Click(object sender, EventArgs e)
        {
            lblError.Visible = false;

            // Ejecutamos la validación antes de consultar [3].
            if (ValidarCamposLogin() == true)
            {
                // Si los datos son correctos y no es primer ingreso, redirige al menú [4].
                if (txtUsuario.Text == "admin001" && txtContrasena.Text == "password123")
                {
                    frmPrincipalAdmin formAdmin = new frmPrincipalAdmin();
                    formAdmin.Show();
                    this.Hide(); 
                }
                // Si los datos son correctos y el usuario tiene activo el flag de primer ingreso,
                // el sistema redirige automáticamente a frmCambioContrasena [4].
                else if (txtUsuario.Text == "msosa456" && txtContrasena.Text == "temporal123")
                {
                    frmCambioContrasena formCambio = new frmCambioContrasena();
                    formCambio.Show();
                    this.Hide();
                }
                else
                {
                    // Si los datos son incorrectos, se muestra un mensaje de error claro y el formulario permanece abierto [5].
                    lblError.Text = "Usuario o contraseña incorrectos.";
                    lblError.Visible = true;
                }
            }
        }

        private void btnMostrarClave_Click(object sender, EventArgs e)
        {
            // Para mostrar/ocultar la contraseña, alternamos la propiedad PasswordChar del TextBox entre '•' y '\0' (caracter nulo) [3].
            if (txtContrasena.PasswordChar == '•')
            {
                txtContrasena.PasswordChar = '\0';
            }
            else
            {
                txtContrasena.PasswordChar = '•';
            }
        }

        private void linkRecuperarClave_LinkClicked(object sender, LinkLabelLinkClickedEventArgs e)
        {
            // El enlace abre el formulario frmRecuperarContrasena [5].
            frmRecuperarContrasena formRecuperar = new frmRecuperarContrasena();
            formRecuperar.Show();
            this.Hide(); 
        }
    }
}
